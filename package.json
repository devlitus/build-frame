{
  "name": "raices",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "e2e:rendimiento": "npm run build && node scripts/e2e.mjs --rendimiento",
    "e2e:completo": "npm run build && node scripts/e2e.mjs --completo",
    "e2e:rapido": "node scripts/e2e.mjs",
    "e2e:humo": "npm run build && playwright test --grep @humo",
    "e2e:capturas": "npm run build && node scripts/e2e.mjs --capturas",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "capturas": "npm run build && node scripts/screenshots.ts",
    "e2e:medir": "npm run build && node scripts/e2e-tiempos.mjs --run"
  },
  "dependencies": {
    "phaser": "~3.90.0",
    "preact": "^11.2.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
